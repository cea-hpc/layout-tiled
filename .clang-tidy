Checks: '-*, bugprone-*, clang-analyzer-*, concurrency-*, cppcoreguidelines-*, -cppcoreguidelines-avoid-magic-numbers, google-*, hicpp-*, llvm-*, -llvm-header-guard, misc-*, modernize-*, performance-*, portability-*, -readability-identifier-*, '
HeaderFilterRegex: '.*/layout_tiled/(include|src|example|tests)/.*\.(hpp)$'
WarningsAsErrors: 'clang*'
FormatStyle: file

CheckOptions:
  - { key: readability-identifier-naming.MemberSuffix, value: _ }
